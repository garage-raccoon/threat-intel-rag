#!/bin/sh
# Block commits that contain secrets (API keys, tokens). Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
